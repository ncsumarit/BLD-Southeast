  "whyAttend": {
    "heading": "Why attend BLD Southeast",
    "intro": "Two days built for people who believe business can be a force for good — and want the tools, network, and community to prove it.",
    "benefits": [
      {
        "title": "Learn from conscious-business practitioners",
        "description": "Sessions and conversations drawn from B Corps and mission-driven leaders putting people-and-planet practices to work every day."
      },
      {
        "title": "Connect with the B Corp community",
        "description": "Meet founders, operators, and advocates from across the Southeast and beyond who are building companies around a stronger bottom line."
      },
      {
        "title": "Support local B Local communities",
        "description": "Every ticket helps fund the regional B Local organizations that keep the conscious-business movement growing where you live."
      }
    ]
  },
  "agenda": {
    "heading": "Full Agenda",
    "overviewHeading": "At a glance",
    "show": true,
    "placeholderNote": "Full agenda coming soon — check back for Day 1 (Sept 16) and Day 2 (Sept 17) session details.",
    "fullAgendaHref": "/agenda/",
    "overview": [
      {
        "label": "Day 1 — Wednesday, September 16",
        "summary": "Optional morning and afternoon excursions across DC — Capitol tours, museum visits, and walking tours — capped by the opening reception at the Martin Luther King Jr. Memorial Library."
      },
      {
        "label": "Day 2 — Thursday, September 17",
        "summary": "The main conference day at GW's Student Center: keynotes, four blocks of concurrent sessions, a congressional plenary, and the closing reception at Tonic at Quigley's."
      },
      {
        "label": "Bonus — Urban Hike · Friday, September 18",
        "summary": "A guided ~5-mile urban hike visiting B Corps across Georgetown and downtown DC, ending at Luke's Lobster Farragut."
      }
    ]
  },
