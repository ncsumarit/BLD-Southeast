---
/**
 * Agenda — schedule not public yet: tasteful "coming soon" state when no
 * days are supplied. No fabricated sessions. Renders real day/session rows
 * once operator supplies them (CMS repeater), same component either way.
 *
 * CMS hints: heading short-text, days repeater (label short-text,
 * sessions repeater{time,title,description}), placeholderNote short-text.
 */
import StackedContent from '~/components/primitives/StackedContent.astro';
import Button from '~/components/Button.astro';

interface AgendaOption {
  title: string;
  description?: string;
}

interface AgendaSession {
  time: string;
  title: string;
  description?: string;
  /** Concurrent choices in this time slot. When present, the session title
   *  acts as the block heading (e.g. "Second afternoon session — choose
   *  one") and the options render as an indented list beneath it — one time
   *  label, clear parent/child hierarchy, instead of the same time repeated
   *  on every parallel row. */
  options?: AgendaOption[];
}

export interface Props {
  heading: string;
  days?: { label: string; sessions: AgendaSession[] }[];
  placeholderNote?: string;
  /** 'overview' renders per-day summary cards + a link to the full agenda
   *  page (homepage use); 'full' renders every session (the /agenda page). */
  variant?: 'full' | 'overview';
  /** Per-day summaries for the overview variant. */
  overview?: { label: string; summary: string }[];
  /** Where the "View full agenda" link points (overview variant). */
  fullHref?: string;
  /** Small eyebrow above the heading. Defaults to "Agenda"; pass an empty
   *  string to hide it (e.g. on the dedicated /agenda page, where an
   *  "AGENDA" eyebrow just duplicates the heading). */
  overline?: string;
}

const {
  heading,
  days = [],
  placeholderNote,
  variant = 'full',
  overview = [],
  fullHref = '/agenda/',
  overline = 'Agenda',
} = Astro.props;
const hasAgenda = days.length > 0;
const isOverview = variant === 'overview' && overview.length > 0;
---

<StackedContent id="agenda" ground="layer-02" measure="content">
  {overline && <p class="agenda-overline">{overline}</p>}
  <h2 class="agenda-heading">{heading}</h2>

  {
    isOverview ? (
      <div class="agenda-overview">
        <ul class="agenda-overview__cards">
          {overview.map((day) => (
            <li class="agenda-overview__card">
              <h3 class="agenda-overview__label">{day.label}</h3>
              <p class="agenda-overview__summary">{day.summary}</p>
            </li>
          ))}
        </ul>
        <Button href={fullHref} variant="secondary">View full agenda →</Button>
      </div>
    ) : hasAgenda ? (
      <div class="agenda-days">
        {days.map((day) => (
          <div class="agenda-day">
            <h3 class="agenda-day__label">{day.label}</h3>
            <ul class="agenda-sessions">
              {day.sessions.map((session) => (
                <li class="agenda-session">
                  <span class="agenda-session__time">{session.time}</span>
                  <span class="agenda-session__body">
                    <span class="agenda-session__title">{session.title}</span>
                    {session.description && <span class="agenda-session__desc">{session.description}</span>}
                    {session.options && session.options.length > 0 && (
                      <ul class="agenda-options">
                        {session.options.map((opt) => (
                          <li class="agenda-option">
                            <span class="agenda-option__title">{opt.title}</span>
                            {opt.description && <span class="agenda-option__desc">{opt.description}</span>}
                          </li>
                        ))}
                      </ul>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <div class="agenda-placeholder">
        <p class="agenda-placeholder__note">{placeholderNote ?? 'Full agenda coming soon.'}</p>
      </div>
    )
  }
</StackedContent>

<style>
  .agenda-overline {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-body-semi);
    text-transform: uppercase;
    letter-spacing: var(--tracking-overline);
    /* --color-primary (teal-500) is 4.07:1 on paper — fails AA 4.5:1 for
       this 14px text. Use the strong variant (7.54:1) instead. */
    color: var(--color-primary-strong);
  }

  .agenda-heading {
    margin: 0 0 var(--space-xl);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--color-text-heading);
  }

  /* Overview variant — per-day summary cards + link to the full agenda. */
  .agenda-overview__cards {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .agenda-overview__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .agenda-overview__card {
    min-width: 0;
    padding: var(--space-lg);
    background-color: var(--layer-03);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .agenda-overview__label {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-primary-strong);
  }

  .agenda-overview__summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .agenda-days {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .agenda-day__label {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-xl);
    color: var(--color-primary-strong);
  }

  .agenda-sessions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .agenda-session {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .agenda-session__time {
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .agenda-session__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    /* 1fr grid column defaults to min-width:auto (= widest content). A long
       unbreakable token — e.g. a raw map URL in a description — would force
       the track past 100% and overflow on mobile. Let it shrink, and break
       long tokens rather than overflow. */
    min-width: 0;
  }

  .agenda-session__title,
  .agenda-session__desc {
    overflow-wrap: break-word;
  }

  .agenda-session__title {
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .agenda-session__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Concurrent options: an indented list under the block heading so the
     shared time reads once, with the parallel choices grouped beneath. */
  .agenda-options {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .agenda-option {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-border);
  }

  .agenda-option__title {
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .agenda-option__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    overflow-wrap: break-word;
  }

  .agenda-placeholder {
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    background-color: var(--layer-03);
    border-radius: var(--radius-lg);
  }

  .agenda-placeholder__note {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    color: var(--color-text-heading);
  }
</style>
