---
/**
 * TravelStay — one-off section (not in the designer's section-patterns.json
 * registry; composed from the StackedContent primitive + tokens per
 * CLAUDE.md "one-offs use primitives" rule). Venue + getting there + hotel
 * deals + TripZero carbon-offset callout. Data source:
 * .build/scraped-content/travel-venue-hotels.md + org.json event.travel/hotels.
 *
 * CMS field-type hints (candidate interface if promoted to the registry):
 *   heading: short-text
 *   venueNote: short-text (arrival/entrance instructions)
 *   venue: object{name,address,neighborhood,metro}
 *   airports: repeater{code,name,transit}
 *   gettingAroundNote: short-text
 *   metroMap: object{thumbnail (image-picker),fileHref (file-picker),alt}
 *   hotels: repeater{name,neighborhood?,walkMin?,rate,bookHref,phone,notes}
 *   bookingDeadline: short-text
 *   carbonOffset: rich-text-editor
 */
import StackedContent from '~/components/primitives/StackedContent.astro';
import Button from '~/components/Button.astro';

export interface Props {
  heading: string;
  venueNote: string;
  partnerUrl: string;
  venue: {
    name: string;
    address: string;
    neighborhood: string;
    metro: string;
  };
  airports: { code: string; name: string; transit: string }[];
  gettingAroundNote?: string;
  metroMap?: { thumbnail: string; fileHref: string; alt?: string };
  hotels: {
    name: string;
    /** Neighborhood + walk time are only shown together when both are
     *  known (see hotel-card__meta below) — some hotels are listed by
     *  amenity/notes only. */
    neighborhood?: string;
    walkMin?: number;
    rate: string;
    bookHref?: string;
    phone?: string;
    notes?: string;
  }[];
  bookingDeadline: string;
  carbonOffsetNote: string;
}

const {
  heading,
  venueNote,
  partnerUrl,
  venue,
  airports,
  gettingAroundNote,
  metroMap,
  hotels,
  bookingDeadline,
  carbonOffsetNote,
} = Astro.props;
---

<StackedContent id="travel" ground="layer-01" measure="content">
  <p class="travel-overline">Travel &amp; Stay</p>
  <h2 class="travel-heading">{heading}</h2>

  <div class="travel-grid">
    <div class="travel-block">
      <h3 class="travel-block__title">Venue</h3>
      <p class="travel-venue__name">{venue.name}</p>
      <p class="travel-venue__address">{venue.address}</p>
      <p class="travel-venue__meta">{venue.neighborhood} &middot; {venue.metro}</p>
      <p class="travel-caveat">{venueNote}</p>
    </div>

    <div class="travel-block">
      <h3 class="travel-block__title">Getting there</h3>
      <ul class="travel-airports">
        {
          airports.map((airport) => (
            <li class="travel-airport">
              <span class="travel-airport__code">{airport.code}</span>
              <span class="travel-airport__body">
                <span class="travel-airport__name">{airport.name}</span>
                <span class="travel-airport__transit">{airport.transit}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    (gettingAroundNote || metroMap) && (
      <div class="travel-around">
        <h3 class="travel-block__title">Getting Around</h3>
        {gettingAroundNote && <p class="travel-around__note">{gettingAroundNote}</p>}
        {metroMap && (
          <a class="travel-metro-map" href={metroMap.fileHref} target="_blank" rel="noopener noreferrer">
            <img
              class="travel-metro-map__thumb"
              src={metroMap.thumbnail}
              alt={metroMap.alt ?? 'DC Metro system map'}
              loading="lazy"
            />
            <span class="travel-metro-map__label">
              View &amp; download the DC Metro map
              <span class="sr-only"> (opens in new tab)</span>
            </span>
          </a>
        )}
      </div>
    )
  }

  <div class="travel-hotels">
    <h3 class="travel-block__title">Attendee hotel deals</h3>
    <p class="travel-deadline">Book by {bookingDeadline} to lock in the event rate.</p>
    <div class="travel-partner-cta">
      <p class="travel-partner-cta__text">
        Stay with fellow B Corps at our event hotels. Our travel partner, <strong>TripZero</strong>, has arranged for
        significantly discounted group rates for BLD SE attendees.
      </p>
      <Button href={partnerUrl} variant="secondary">Book your stay on TripZero</Button>
    </div>
    <div class="travel-hotel-grid">
      {
        hotels.map((hotel) => (
          <article class="hotel-card">
            <h4 class="hotel-card__name">{hotel.name}</h4>
            {hotel.neighborhood && hotel.walkMin != null && (
              <p class="hotel-card__meta">
                {hotel.neighborhood} &middot; {hotel.walkMin} min walk to venue
              </p>
            )}
            <p class="hotel-card__rate">
              {hotel.rate} <span class="hotel-card__rate-note">event rate*</span>
            </p>
            {hotel.notes && <p class="hotel-card__notes">{hotel.notes}</p>}
            <div class="hotel-card__actions">
              {hotel.bookHref && (
                <a class="hotel-card__book" href={hotel.bookHref} target="_blank" rel="noopener noreferrer">
                  Book this rate &rarr;
                  <span class="sr-only"> (opens in new tab)</span>
                </a>
              )}
              {hotel.phone && <span class="hotel-card__phone">{hotel.phone}</span>}
            </div>
          </article>
        ))
      }
    </div>
    <p class="travel-rate-disclaimer">*Rates vary by room/bed type — request the event rate when booking.</p>
  </div>

  <div class="travel-carbon">
    <p class="travel-carbon__label">Carbon offset</p>
    <p class="travel-carbon__note">{carbonOffsetNote}</p>
  </div>
</StackedContent>

<style>
  .travel-overline {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-body-semi);
    text-transform: uppercase;
    letter-spacing: var(--tracking-overline);
    /* --color-primary (teal-500) is 4.07:1 on paper — fails AA 4.5:1 for
       this 14px text. Use the strong variant (7.54:1) instead. */
    color: var(--color-primary-strong);
  }

  .travel-heading {
    margin: 0 0 var(--space-2xl);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--color-text-heading);
  }

  .travel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .travel-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .travel-block__title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-lg);
    color: var(--color-primary-strong);
  }

  .travel-venue__name {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .travel-venue__address,
  .travel-venue__meta {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .travel-caveat {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-accent-text);
  }

  .travel-airports {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .travel-airport {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-sm);
  }

  .travel-airport__code {
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-lg);
    color: var(--color-primary);
  }

  .travel-airport__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .travel-airport__name {
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .travel-airport__transit {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .travel-around {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-2xl);
  }

  .travel-around__note {
    margin: 0 0 var(--space-lg);
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .travel-metro-map {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm);
    background-color: var(--layer-03);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: box-shadow var(--transition-ui);
  }
  .travel-metro-map:hover {
    box-shadow: var(--shadow-md);
  }
  .travel-metro-map:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .travel-metro-map__thumb {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .travel-metro-map__label {
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-sm);
    color: var(--color-link);
  }

  .travel-hotels {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-2xl);
  }

  .travel-deadline {
    margin: 0 0 var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .travel-partner-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding: var(--space-lg);
    background-color: var(--layer-02);
    border-radius: var(--radius-md);
  }

  .travel-partner-cta__text {
    margin: 0;
    flex: 1 1 18rem;
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text);
  }

  .travel-hotel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-gap);
  }

  @media (min-width: 640px) {
    .travel-hotel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hotel-card {
    padding: var(--space-lg);
    background-color: var(--layer-03);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-ui);
  }
  /* Card contains a real interactive link ("Book this rate") — lift the
     whole card on hover/focus-within, per project convention for clickable
     cards (hover on the wrapper, not just the inner link). */
  .hotel-card:hover,
  .hotel-card:focus-within {
    box-shadow: var(--shadow-md);
  }

  .hotel-card__name {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-lg);
    color: var(--color-text-heading);
  }

  .hotel-card__meta {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hotel-card__rate {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-lg);
    color: var(--color-primary-strong);
  }
  .hotel-card__rate-note {
    font-family: var(--font-body);
    font-weight: var(--weight-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .hotel-card__notes {
    margin: 0 0 var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .hotel-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hotel-card__book {
    font-family: var(--font-body);
    font-weight: var(--weight-body-semi);
    font-size: var(--text-sm);
    color: var(--color-link);
    text-decoration: none;
  }
  .hotel-card__book:hover {
    color: var(--color-link-hover);
  }
  .hotel-card__book:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .hotel-card__phone {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .travel-rate-disclaimer {
    margin: var(--space-md) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .travel-carbon {
    padding: var(--space-lg);
    background-color: var(--layer-02);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-highlight-green);
  }

  .travel-carbon__label {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-body-semi);
    text-transform: uppercase;
    letter-spacing: var(--tracking-overline);
    color: var(--color-primary-strong);
  }

  .travel-carbon__note {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }
</style>
