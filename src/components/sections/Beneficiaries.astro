---
/**
 * Beneficiaries — 6 B Local logos, framed as proceeds recipients (not
 * sponsors). Tile grid/rendering lives in the shared LogoGrid primitive
 * (via LogoTileGrid), also used per-tier by Sponsors.astro.
 *
 * CMS hints: heading short-text, framingLine rich-text-editor,
 * logos repeater{name,logo,url?}.
 */
import LogoTileGrid from '~/components/primitives/LogoTileGrid.astro';

export interface Props {
  heading: string;
  framingLine?: string;
  logos: { name: string; logo: string; url?: string }[];
}

const { heading, framingLine, logos } = Astro.props;
---

<LogoTileGrid id="beneficiaries" ground="layer-02" logos={logos}>
  <Fragment slot="intro">
    <p class="beneficiaries-overline">Beneficiaries</p>
    <h2 class="beneficiaries-heading">{heading}</h2>
    {framingLine && <p class="beneficiaries-framing">{framingLine}</p>}
  </Fragment>
</LogoTileGrid>

<style>
  .beneficiaries-overline {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-body-semi);
    text-transform: uppercase;
    letter-spacing: var(--tracking-overline);
    /* --color-primary (teal-500) is 4.07:1 on paper — fails AA 4.5:1 for
       this 14px text. Use the strong variant (7.54:1) instead. */
    color: var(--color-primary-strong);
  }

  .beneficiaries-heading {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--color-text-heading);
  }

  .beneficiaries-framing {
    margin: 0;
    max-width: var(--space-prose-max);
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }
</style>
