---
/**
 * Header — sticky site header. Transparent over the hero ink-teal band,
 * condenses to a light, blurred bar on scroll. Persistent orange Register
 * CTA stays visible at all times, including the mobile collapsed state.
 *
 * CMS field-type hints:
 *   logo: image-picker
 *   anchorLinks: repeater (label: short-text, href: short-text)
 *   registerCta: link-picker
 */
import Button from '~/components/Button.astro';

export interface Props {
  logo: { src: string; alt: string };
  anchorLinks: { label: string; href: string }[];
  registerCta: { label: string; href: string };
}

const { logo, anchorLinks, registerCta } = Astro.props;
---

<header class="site-header" id="site-header" data-site-header>
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label={`${logo.alt} — home`}>
      <img src={logo.src} alt={logo.alt} width="140" height="55" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links" id="site-header-links">
        {
          anchorLinks.map((link) => (
            <li>
              <a href={link.href} class="site-header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={registerCta.href} variant="primary" class="site-header__cta">
        {registerCta.label}
      </Button>
      <button
        type="button"
        class="site-header__toggle"
        id="site-header-toggle"
        aria-expanded="false"
        aria-controls="site-header-links"
        aria-label="Toggle navigation menu"
      >
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

{
  /* A plain src-referenced script, not Astro's managed inline <script>
     block - Astro/Vite sometimes inlines small single-use scripts directly
     into the built HTML, which our strict CSP (no 'unsafe-inline' in
     script-src) silently blocks in production. A public/ file loaded by
     src is always same-origin ('self') and never touched by that inlining
     behavior. This bit us once: the sticky header's scroll/menu JS never
     ran on the deployed site because of exactly this. */
}
<script src="/js/header.js" defer></script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: var(--z-modal);
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
  }
  .skip-link:focus-visible {
    left: var(--space-sm);
    top: var(--space-sm);
  }

  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
    background-color: transparent;
    transition: background-color var(--transition-ui), height var(--transition-ui), box-shadow var(--transition-ui);
  }

  .site-header.is-scrolled {
    height: var(--header-height-scroll);
    /* Solid white, not the page's own paper tone — sections below are the
       same cream color, so a paper-tinted header was invisible against them. */
    background-color: var(--white);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md);
  }

  .site-header__bar {
    width: 100%;
    max-width: var(--space-content-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
  }
  .site-header__logo img {
    display: block;
    height: 2.25rem;
    width: auto;
    max-width: none;
    /* Logo asset is white-on-transparent; render it dark for the light header. */
    filter: brightness(0);
    transition: filter var(--transition-ui);
  }
  .site-header.is-scrolled .site-header__logo img {
    filter: brightness(0);
  }
  .site-header__logo:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .site-header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .site-header__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .site-header__links {
      display: flex;
    }
  }

  .site-header__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2xs);
    font-family: var(--font-body);
    font-weight: var(--weight-body-med);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-ui);
  }
  .site-header.is-scrolled .site-header__link {
    color: var(--color-text);
  }
  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background-color: currentColor;
    transition: right var(--transition-ui);
  }
  .site-header__link:hover::after {
    right: 0;
  }
  .site-header__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-header__cta {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-md);
  }

  .site-header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .site-header__toggle {
      display: none;
    }
  }
  .site-header__toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }
  .site-header__toggle-bar {
    display: block;
    width: 1.5rem;
    height: 2px;
    background-color: var(--color-text);
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-ui), transform var(--transition-ui), opacity var(--transition-ui);
  }
  .site-header.is-scrolled .site-header__toggle-bar {
    background-color: var(--color-text);
  }
  .site-header.is-menu-open .site-header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.is-menu-open .site-header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header.is-menu-open .site-header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1023px) {
    /*
     * Collapsible mobile panel via the CSS grid-rows technique instead of
     * a guessed max-height ceiling. `height: auto` can't be transitioned,
     * so the common workaround is animating `max-height` to a hardcoded
     * number — but any number you pick is either too small (clips content,
     * as happened here once Sponsors/Travel were added) or too generous
     * (dead space on short menus, breaks on short viewports). Animating
     * `grid-template-rows` from 0fr to 1fr instead resolves to the
     * content's real height at every frame — no ceiling to guess, and it
     * never needs revisiting as nav items are added or removed.
     * Reference: https://css-tricks.com/css-grid-can-do-auto-height-transitions/
     */
    .site-header__nav {
      position: fixed;
      inset-inline: 0;
      top: var(--header-height);
      display: grid;
      grid-template-rows: 0fr;
      /* Reset the desktop horizontal-flex-bar's justify-content: center —
         irrelevant here and was visually centering/indenting the stacked
         mobile links instead of letting them sit flush to the gutter. */
      justify-content: normal;
      background-color: var(--color-bg);
      transition: grid-template-rows var(--transition-express);
      padding-inline: var(--space-gutter);
    }
    .site-header:not(.is-menu-open) .site-header__nav {
      pointer-events: none;
    }
    .site-header.is-menu-open .site-header__nav {
      grid-template-rows: 1fr;
      /* Padding must be gated by open state, not applied unconditionally —
         padding is its own box-model layer and does NOT shrink away with
         the row track, so an always-on padding here would leave a fixed
         gap visible even at grid-template-rows: 0fr (this bit us once:
         a stray 64px gap when "closed" turned out to be exactly this). */
      padding-block: var(--space-lg);
      box-shadow: var(--shadow-md);
    }
    .site-header__links {
      /* Base rule hides this list until the 1024px breakpoint (desktop
         inline nav); the mobile open-menu panel needs it visible too, or
         the panel opens with the toggle animated but no links inside. */
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      width: 100%;
      /* Required by the grid-rows technique: the single grid item must be
         allowed to shrink below its content size (min-height: 0) and clip
         (overflow: hidden) for the 0fr state to actually collapse to zero
         instead of being forced open by its own intrinsic content height. */
      overflow: hidden;
      min-height: 0;
    }
    .site-header__link {
      color: var(--color-text);
      font-size: var(--text-md);
    }
  }
</style>
