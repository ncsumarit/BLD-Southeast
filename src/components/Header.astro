---
/**
 * Header — sticky site header. Transparent over the hero ink-teal band,
 * condenses to a light, blurred bar on scroll. Persistent orange Register
 * CTA stays visible at all times, including the mobile collapsed state.
 *
 * CMS field-type hints:
 *   logo: image-picker
 *   anchorLinks: repeater (label: short-text, href: short-text)
 *   registerCta: link-picker
 */
import Button from '~/components/Button.astro';

export interface Props {
  logo: { src: string; alt: string };
  anchorLinks: { label: string; href: string }[];
  registerCta: { label: string; href: string };
}

const { logo, anchorLinks, registerCta } = Astro.props;
---

<header class="site-header" id="site-header" data-site-header>
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label={`${logo.alt} — home`}>
      <img src={logo.src} alt={logo.alt} width="140" height="55" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links" id="site-header-links">
        {
          anchorLinks.map((link) => (
            <li>
              <a href={link.href} class="site-header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={registerCta.href} variant="primary" class="site-header__cta">
        {registerCta.label}
      </Button>
      <button
        type="button"
        class="site-header__toggle"
        id="site-header-toggle"
        aria-expanded="false"
        aria-controls="site-header-links"
        aria-label="Toggle navigation menu"
      >
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.getElementById('site-header-toggle');
  const links = document.getElementById('site-header-links');

  const setScrolled = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    header?.classList.toggle('is-menu-open', !expanded);
  });

  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-menu-open');
    });
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: var(--z-modal);
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
  }
  .skip-link:focus {
    left: var(--space-sm);
    top: var(--space-sm);
  }

  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
    background-color: transparent;
    transition: background-color var(--transition-ui), height var(--transition-ui), box-shadow var(--transition-ui);
  }

  .site-header.is-scrolled {
    height: var(--header-height-scroll);
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
  }

  .site-header__bar {
    width: 100%;
    max-width: var(--space-content-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
  }
  .site-header__logo img {
    display: block;
    height: 2.25rem;
    width: auto;
    max-width: none;
    /* Logo asset is white-on-transparent; render it dark for the light header. */
    filter: brightness(0);
    transition: filter var(--transition-ui);
  }
  .site-header.is-scrolled .site-header__logo img {
    filter: brightness(0);
  }
  .site-header__logo:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .site-header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .site-header__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .site-header__links {
      display: flex;
    }
  }

  .site-header__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2xs);
    font-family: var(--font-body);
    font-weight: var(--weight-body-med);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-ui);
  }
  .site-header.is-scrolled .site-header__link {
    color: var(--color-text);
  }
  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background-color: currentColor;
    transition: right var(--transition-ui);
  }
  .site-header__link:hover::after,
  .site-header__link[aria-current='page']::after {
    right: 0;
  }
  .site-header__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-header__cta {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-md);
  }

  .site-header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .site-header__toggle {
      display: none;
    }
  }
  .site-header__toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }
  .site-header__toggle-bar {
    display: block;
    width: 1.5rem;
    height: 2px;
    background-color: var(--color-text);
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-ui), transform var(--transition-ui), opacity var(--transition-ui);
  }
  .site-header.is-scrolled .site-header__toggle-bar {
    background-color: var(--color-text);
  }
  .site-header.is-menu-open .site-header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.is-menu-open .site-header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header.is-menu-open .site-header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .site-header.is-menu-open .site-header__nav {
      position: fixed;
      inset-inline: 0;
      top: var(--header-height);
      display: flex;
      background-color: var(--color-bg);
      box-shadow: var(--shadow-md);
      padding: var(--space-lg) var(--space-gutter);
    }
    .site-header:not(.is-menu-open) .site-header__nav {
      pointer-events: none;
    }
    .site-header .site-header__nav {
      position: fixed;
      inset-inline: 0;
      top: var(--header-height);
      max-height: 0;
      overflow: hidden;
      background-color: var(--color-bg);
      transition: max-height var(--transition-express);
      padding-inline: var(--space-gutter);
    }
    .site-header.is-menu-open .site-header__nav {
      max-height: 24rem;
      padding-block: var(--space-lg);
      box-shadow: var(--shadow-md);
    }
    .site-header__links {
      flex-direction: column;
      gap: var(--space-md);
      width: 100%;
    }
    .site-header__link {
      color: var(--color-text);
      font-size: var(--text-md);
    }
  }
</style>
