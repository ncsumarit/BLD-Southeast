---
/**
 * Favicons — BLD Southeast's B Corp mark (the same "B" icon used in the
 * header/footer logo lockup), generated from the scraped source-site asset
 * (public/images/b-corp-icon-favicon.png) via sharp. See src/assets/favicons/.
 */
import favicon32 from '~/assets/favicons/favicon-32.png';
import favicon16 from '~/assets/favicons/favicon-16.png';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';
---

<link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
<link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
<link rel="shortcut icon" href={favicon32.src} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
