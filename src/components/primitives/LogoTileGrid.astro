---
/**
 * LogoTileGrid — full section wrapper (heading/intro slot + tile grid) for
 * partner/beneficiary logos. The actual grid/tile rendering lives in the
 * shared LogoGrid primitive (also used per-tier by Sponsors.astro).
 */
import LogoGrid, { type LogoItem } from './LogoGrid.astro';

export interface Props {
  logos: LogoItem[];
  ground?: 'layer-01' | 'layer-02' | 'layer-03';
  id?: string;
  class?: string;
}

const { logos, ground = 'layer-02', id, class: className = '' } = Astro.props;
---

<section id={id} class:list={['logo-tile-section', `logo-tile-section--${ground}`, className]}>
  <div class="logo-tile-section__inner">
    <div class="logo-tile-section__intro">
      <slot name="intro" />
    </div>
    <LogoGrid logos={logos} columnsAtDesktop={3} tilePadding="var(--space-sm)" />
  </div>
</section>

<style>
  .logo-tile-section {
    padding-block: var(--space-section);
  }
  .logo-tile-section--layer-01 {
    background-color: var(--layer-01);
  }
  .logo-tile-section--layer-02 {
    background-color: var(--layer-02);
  }
  .logo-tile-section--layer-03 {
    background-color: var(--layer-03);
  }

  .logo-tile-section__inner {
    max-width: var(--space-content-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .logo-tile-section__intro {
    max-width: var(--space-prose-max);
    margin-bottom: var(--space-2xl);
  }
</style>
