---
/**
 * LogoTileGrid — uniform equal-height tiles containing partner/beneficiary
 * logos with contained scaling (object-fit: contain). Normalizes mixed
 * aspect ratios (the exact problem flagged in the source-site audit).
 */
export interface Props {
  ground?: 'layer-01' | 'layer-02' | 'layer-03';
  id?: string;
  class?: string;
}

const { ground = 'layer-02', id, class: className = '' } = Astro.props;
---

<section id={id} class:list={['logo-tile-section', `logo-tile-section--${ground}`, className]}>
  <div class="logo-tile-section__inner">
    <div class="logo-tile-section__intro">
      <slot name="intro" />
    </div>
    <div class="logo-tile-grid">
      <slot />
    </div>
  </div>
</section>

<style>
  .logo-tile-section {
    padding-block: var(--space-section);
  }
  .logo-tile-section--layer-01 {
    background-color: var(--layer-01);
  }
  .logo-tile-section--layer-02 {
    background-color: var(--layer-02);
  }
  .logo-tile-section--layer-03 {
    background-color: var(--layer-03);
  }

  .logo-tile-section__inner {
    max-width: var(--space-content-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .logo-tile-section__intro {
    max-width: var(--space-prose-max);
    margin-bottom: var(--space-2xl);
  }

  .logo-tile-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-gap);
  }

  /* 3 across (→ 2 rows of 3 for six logos) from tablet up. */
  @media (min-width: 640px) {
    .logo-tile-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
