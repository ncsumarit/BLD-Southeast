---
/**
 * LegalLayout — minimal prose page shell for legal content (Privacy Policy),
 * using the site's own BaseLayout (brand Header/Footer/CookieConsent) rather
 * than AstroWind's generic PageLayout, so /privacy/ stays on-brand.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<BaseLayout metadata={metadata}>
  <section class="legal">
    <div class="legal__inner">
      <h1 class="legal__title">{frontmatter.title}</h1>
      <div class="legal__prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: calc(var(--header-height) + var(--space-2xl)) var(--space-2xl);
    background-color: var(--layer-01);
  }

  .legal__inner {
    max-width: var(--space-prose-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .legal__title {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
  }

  .legal__prose {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .legal__prose :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-xl);
    color: var(--color-text-heading);
  }

  .legal__prose :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-lg);
    color: var(--color-text-heading);
  }

  .legal__prose :global(p) {
    margin: 0 0 var(--space-md);
  }

  .legal__prose :global(ul) {
    margin: 0 0 var(--space-md);
    padding-left: var(--space-lg);
  }

  .legal__prose :global(li) {
    margin-bottom: var(--space-2xs);
  }

  .legal__prose :global(a) {
    color: var(--color-link);
  }
  .legal__prose :global(a:hover) {
    color: var(--color-link-hover);
  }
</style>
