---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import Button from '~/components/Button.astro';

const metadata = { title: 'Page Not Found' };
---

<BaseLayout metadata={metadata}>
  <section class="error-404">
    <div class="error-404__inner">
      <h1 class="error-404__code"><span class="sr-only">Error</span>404</h1>
      <p class="error-404__title">Sorry, we couldn't find this page.</p>
      <p class="error-404__body">But don't worry — you can find plenty of other things on our homepage.</p>
      <Button href={getHomePermalink()} variant="secondary">Back to homepage</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .error-404 {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-section);
    padding-inline: var(--space-gutter);
    background-color: var(--layer-01);
  }

  .error-404__inner {
    max-width: var(--space-prose-max);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .error-404__code {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display-bold);
    font-size: var(--text-4xl);
    color: var(--color-primary-strong);
  }

  .error-404__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-xl);
    color: var(--color-text-heading);
  }

  .error-404__body {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }
</style>
