---
/**
 * BLD Southeast 2026 — single landing page (CMS_SETUP phase).
 * Section order per .build/architecture-summary.md + design-system.json
 * sectionVarietyPlan, with the Travel & Stay section inserted between
 * Beneficiaries and RegisterCTA per the operator-approved brief.
 *
 * CONTENT MODEL: every editable piece of this page is sourced from
 * content/landing.json (single structured content file), edited visually
 * via TinaCMS at /admin (see tina/config.ts for the schema). This import is
 * a direct, build-time JSON read — `npm run build` always works standalone,
 * with or without Tina/TinaCloud reachable.
 *
 * PastYears is intentionally NOT rendered — it was entirely invented copy
 * (no real photos/stats). The component file is kept for later; it is not
 * part of the content model.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';

import Hero from '~/components/sections/Hero.astro';
import About from '~/components/sections/About.astro';
import WhyAttend from '~/components/sections/WhyAttend.astro';
import Agenda from '~/components/sections/Agenda.astro';
import Speakers from '~/components/sections/Speakers.astro';
import Beneficiaries from '~/components/sections/Beneficiaries.astro';
import Sponsors, { type SponsorTier } from '~/components/sections/Sponsors.astro';
import TravelStay from '~/components/sections/TravelStay.astro';
import RegisterCTA from '~/components/sections/RegisterCTA.astro';

import EventSchema from '~/components/schema/EventSchema.astro';
import OrganizationSchema from '~/components/schema/OrganizationSchema.astro';
import WebSiteSchema from '~/components/schema/WebSiteSchema.astro';

import content from '../../content/landing.json';

const SITE_URL = 'https://bldsoutheast.com/';

const { seo, hero, about, whyAttend, agenda, speakers, beneficiaries, sponsors, travelStay, registerCta } = content;

const metadata = {
  title: seo.title,
  description: seo.description,
  ignoreTitleTemplate: true,
};

// About body: only render non-empty paragraphs (bodySecondary is left
// empty until the operator supplies real copy — see CMS_SETUP notes).
const aboutBody = [about.body, about.bodySecondary].filter((p): p is string => Boolean(p && p.trim().length > 0));

// FAQ has no real answers yet (operator input pending) — section stays
// unrendered; not part of the content model until real Q&A exists.
---

<BaseLayout metadata={metadata}>
  <EventSchema
    name="BLD Southeast 2026"
    startDate="2026-09-16"
    endDate="2026-09-17"
    url={SITE_URL}
    image={`${SITE_URL}images/hero-dc-background.jpg`}
    venueName="George Washington University – Student Center"
    streetAddress="800 21st St NW, 3rd Floor"
    city="Washington"
    state="DC"
    postalCode="20052"
    offerUrl={hero.primaryCta.href}
    organizerName="BLD Southeast"
    organizerUrl={SITE_URL}
  />
  <OrganizationSchema name="BLD Southeast" url={SITE_URL} logo={`${SITE_URL}images/bld-southeast-logo-white.png`} />
  <WebSiteSchema name="BLD Southeast" url={SITE_URL} />

  <Hero
    eyebrow={hero.eyebrow}
    headline={hero.headline}
    dateLine={hero.dateLine}
    locationLine={hero.locationLine}
    primaryCta={hero.primaryCta}
    tertiaryCta={hero.tertiaryCta}
    backgroundImage={hero.heroImage}
    backgroundAlt={hero.heroImageAlt}
  />

  <About
    heading={about.heading}
    body={aboutBody}
    image={about.image}
    imageAlt={about.imageAlt}
    secondaryCta={hero.primaryCta}
  />

  <!--
    WhyAttend: benefits copy is flagged in tina/config.ts as PLACEHOLDER —
    first-pass AI-drafted, needs real reasons to attend before launch.
  -->
  <WhyAttend heading={whyAttend.heading} intro={whyAttend.intro} benefits={whyAttend.benefits} />

  <Beneficiaries heading={beneficiaries.heading} logos={beneficiaries.logos} />

  <Sponsors heading={sponsors.heading} intro={sponsors.intro} tiers={sponsors.tiers as SponsorTier[]} />

  <TravelStay
    heading={travelStay.heading}
    partnerUrl={travelStay.partnerUrl}
    venueNote={travelStay.venueNote}
    venue={travelStay.venue}
    airports={travelStay.airports}
    gettingAroundNote={travelStay.gettingAroundNote}
    metroMap={travelStay.metroMap}
    hotels={travelStay.hotels}
    bookingDeadline={travelStay.bookingDeadline}
    carbonOffsetNote={travelStay.carbonOffsetNote}
  />

  <!--
    Agenda and Speakers moved to the bottom of the page (just above the
    final Register CTA) — both are still placeholder "coming soon" states
    with no real content yet, so they shouldn't compete with the sections
    that ARE filled out (About, WhyAttend, Beneficiaries, Sponsors, Travel)
    for the visitor's early attention. Re-promote them once real
    sessions/speakers exist.
  -->
  <!-- Agenda: homepage shows a per-day overview; full schedule lives at /agenda/. -->
  {
    agenda.show && (
      <Agenda
        heading={agenda.overviewHeading}
        variant="overview"
        overview={agenda.overview}
        fullHref={agenda.fullAgendaHref}
      />
    )
  }

  <!-- Speakers: none confirmed yet — renders "to be announced" placeholder. -->
  {
    speakers.show && (
      <Speakers
        heading={speakers.heading}
        intro={speakers.intro}
        speakers={speakers.speakers}
        placeholderNote={speakers.placeholderNote}
      />
    )
  }

  <!-- PastYears: cut — no real photos/stats exist (no-fabricated-social-proof rule). Component kept for later, not content-modeled. -->

  <!-- FAQ: hidden for now (operator request) — real answers pending, not yet part of the content model. -->

  <RegisterCTA
    heading={registerCta.heading}
    subhead={registerCta.subhead}
    cta={registerCta.cta}
    backgroundImage={registerCta.backgroundImage}
  />
</BaseLayout>
